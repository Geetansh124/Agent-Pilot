# Copy this file to .env and replace placeholders locally. Never commit real secrets.

# Required for model-backed chat; use the provider configured by the backend.
NVIDIA_API_KEY=replace_with_provider_key

# Optional integrations
ALPHAVANTAGE_API_KEY=
GOOGLE_DRIVE_OAUTH_JSON=

# Local API security and frontend CORS
JWT_SECRET_KEY=replace_with_a_long_random_secret
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001
PORT=8000
